# Copy to .env.local.

# Public by design — these ship in the browser bundle. RLS is the security
# boundary, not secrecy of the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS entirely. Read solely by getExtensionCode(), which
# is locked to the logged-in user's own email. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
